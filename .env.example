# =============================================================================
# DataPilot AI: backend settings. Copy to .env and fill in.
# Everything else has a sensible default in app/config.py (see tutorial.md).
# =============================================================================

# --- App ---------------------------------------------------------------------
APP_ENV=development                 # development | production
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173  # frontend URL(s), comma-separated

# --- LLM providers -----------------------------------------------------------
# A provider is enabled only when its API key is set.
# <NAME>_MODELS = models users can pick in the UI for that provider.
NEBIUS_API_KEY=
NEBIUS_MODELS=nvidia/Nemotron-3_5-Lightning,Qwen/Qwen3-235B-A22B-Instruct-2507

GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash

OPENAI_API_KEY=
OPENAI_MODELS=gpt-4.1

# --- Model order for "Auto" ("provider:model") --------------------------------
LLM_PRIMARY=nebius:nvidia/Nemotron-3_5-Lightning
LLM_SECONDARY=gemini:gemini-3.5-flash   # used when the primary fails

# --- Production only ---------------------------------------------------------
# SESSION_BACKEND=redis
# REDIS_URL=redis://localhost:6379/0
# RATE_LIMIT_STORAGE_URI=redis://localhost:6379/1
# PROXY_FIX_HOPS=1
