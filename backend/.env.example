# =============================================================================
# DataPilot AI: backend configuration
# Copy to backend/.env and fill in. Every value here can be overridden by a
# real environment variable (e.g. in Docker / your hosting platform).
# =============================================================================

# --- App ---------------------------------------------------------------------
APP_ENV=development                 # development | production
SECRET_KEY=change-me-to-a-long-random-string   # encrypts session credentials
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173  # comma-separated frontend origins
PROXY_FIX_HOPS=0                    # 1 when behind nginx / a load balancer

# --- LLM providers (all OpenAI-compatible) ------------------------------------
# A provider is enabled when its API key is set. Add more by appending a name
# to LLM_PROVIDERS and defining <NAME>_API_KEY and <NAME>_BASE_URL.
LLM_PROVIDERS=nebius,gemini,openai

NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Model roles ("<provider>:<model name>") ---------------------------------
# primary:   default model for every agent
# secondary: automatic fallback when the primary fails
# reasoning: SQL agent (writes and repairs SQL). Defaults to primary
# fast:      router, schema selection, insights, charts. Defaults to primary
LLM_PRIMARY=nebius:nvidia/Llama-3_3-Nemotron-Super-49B-v1_5
LLM_SECONDARY=gemini:gemini-2.5-flash
LLM_REASONING=nebius:nvidia/Llama-3_3-Nemotron-Super-49B-v1_5
LLM_FAST=gemini:gemini-2.5-flash

# Models users can pick in the UI (role models are always included).
LLM_AVAILABLE_MODELS=nebius:nvidia/Llama-3_3-Nemotron-Super-49B-v1_5,gemini:gemini-2.5-flash,gemini:gemini-2.5-pro,openai:gpt-4o-mini,openai:gpt-4.1

LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=4096

# --- Agents ------------------------------------------------------------------
MAX_SQL_RETRIES=2                   # self-correction attempts after a failed query
SCHEMA_FULL_CONTEXT_MAX_TABLES=15   # above this, the schema agent selects tables
SCHEMA_SAMPLE_ROWS=3                # sample rows per table shown to the SQL agent
CHAT_HISTORY_TURNS=6                # prior turns used for follow-up questions

# --- Data access / safety ----------------------------------------------------
DEMO_DB_PATH=data/demo.db           # auto-created on first start
QUERY_ROW_LIMIT=1000
QUERY_TIMEOUT_SECONDS=15
ALLOWED_DB_TYPES=sqlite_demo,postgresql,mysql
MAX_MESSAGE_CHARS=4000

# --- Sessions / infrastructure -----------------------------------------------
SESSION_BACKEND=memory              # memory | redis (redis for multi-worker/replicas)
SESSION_TTL_MINUTES=60
REDIS_URL=redis://localhost:6379/0
ENGINE_CACHE_SIZE=64
RATE_LIMIT=30/minute
RATE_LIMIT_STORAGE_URI=memory://    # redis://... in multi-worker deployments
